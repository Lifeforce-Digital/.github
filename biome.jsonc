/** IMPORTANT: Ensure the following is added to ./vscode/settings.json
	```
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.biome": "explicit"
	}
	```
*/

{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist"
			// "!!**/package.json",
			// "!!**/pnpm-lock.yaml",
			// "!!**/pnpm-workspace.yaml",
			// "!!**/package-lock.json",
			// "!!**/yarn.lock"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				// Needed for NestJS projects
				"useImportType": "off"
			}
		}
	},
	// Applies to both JavaScript and TypeScript
	"javascript": {
		"formatter": {
			"quoteStyle": "single" // Default is `double`
		},
		"parser": {
			// Needed for NestJS projects
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	// "overrides": [
	// 	{
	// 		"includes": ["**/*.controller.ts", "**/*.service.ts"],
	// 		"linter": {
	// 			"rules": {
	// 				"style": {
	// 					"useImportType": "off"
	// 				}
	// 			}
	// 		}
	// 	}
	// ],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
